# Long-lived login from `claude setup-token` (valid for a year)
CLAUDE_CODE_OAUTH_TOKEN=
# Callers send "Authorization: Bearer <RUNNER_TOKEN>"; empty means no check
RUNNER_TOKEN=
RUNNER_ROUTE=anthropic
RUNNER_MAX_RUNS=3
# Copilot route through LiteLLM's Anthropic endpoint (base URL without /v1)
LITELLM_URL=http://localhost:4000
LITELLM_KEY=
COPILOT_MODELS=claude-opus-5-5=copilot-claude-opus,claude-opus-5=copilot-claude-opus,claude-haiku-4-5=copilot-claude-haiku
# Skip the copilot route until this date (YYYY-MM-DD), e.g. when the monthly quota is used up
COPILOT_FROM=
